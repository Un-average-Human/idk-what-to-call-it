[application]

config/name="airship system"
run/main_scene="uid://71bmn0d7714o"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

SignalBus="*uid://x8w6hewa23gf"
MultiplayerPlayer="*uid://cebgl2my0633q"
MultiplayerLobbies="*uid://c4cvfa6dojeij"
